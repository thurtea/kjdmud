# Build tree (rebuild locally with cmake, never sync via git)
build/
build_debug/

# Lil's own real, by-design runtime scratch file (mudlib/command/
# eval.c writes this on every "eval" command use, then relies on the
# driver recompiling it fresh each time: see ROADMAP.md's own
# programCache_ invalidation row). Regenerated with arbitrary session
# content any time eval is exercised, never meant to be tracked.
mudlib/tmp_eval_file.c

# Vendored FluffOS reference build tree artifacts (kept for citation only,
# never compiled as part of this project's own build)
reference/fluffos-2.9-ds2.08/tmp/
reference/fluffos-2.9-ds2.08/obj/
reference/fluffos-2.9-ds2.08/driver
reference/fluffos-2.9-ds2.08/addr_server
reference/fluffos-2.9-ds2.08/portbind
reference/fluffos-2.9-ds2.08/edit_source
reference/fluffos-2.9-ds2.08/comptest
reference/fluffos-2.9-ds2.08/packages/packages.a

# Python bytecode caches
__pycache__/
*.pyc

# Scratch comparison clones (temp/dgd, temp/fluffos, temp/ldmud), other
# reference drivers' own real source trees, pulled locally for Phase 1
# dialect-planning research the same way reference/fluffos-2.9-ds2.08 is
# vendored for Phase 0, but not vendored into this repo the way that one
# is: no citation/attribution setup done for them, so never sync via git.
temp/

# Personal scoping/planning notes, not part of the public repo.
notes/
